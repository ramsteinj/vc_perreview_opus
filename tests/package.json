{
  "name": "vc-perreview-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright E2E 테스트 (specs/11-e2e-testing.md)",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:chrome": "playwright test --project=chrome",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
