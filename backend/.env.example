DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# docker compose의 db 서비스는 호스트 5433 포트로 노출된다
DATABASE_URL=postgres://perreview:perreview@localhost:5433/perreview

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 기본 관리자 부트스트랩 (specs/03-auth.md §5)
DEFAULT_ADMIN_NAME=ADMIN
DEFAULT_ADMIN_EMPLOYEE_NO=ADMIN
DEFAULT_ADMIN_PASSWORD=admin1234!

# 로그인 시도 제한
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=600
